<footer class="site-footer" role="contentinfo">
  <div class="site-footer__top">
    <div class="container">
      <div class="site-footer__grid">

        {%- comment -%} Company Info {%- endcomment -%}
        <div class="site-footer__company">
          <div class="site-footer__brand">
            <div class="site-footer__brand-icon"><span>E</span></div>
            <span class="site-footer__brand-name">{{ shop.name | upcase | default: 'E-BIKES' }}</span>
          </div>
          <p class="site-footer__about">
            {{ section.settings.about_text | default: 'Leading the electric revolution with innovative, sustainable, and high-performance e-bikes.' }}
          </p>
          <div class="site-footer__social">
            {%- if section.settings.facebook_url != blank -%}
              <a href="{{ section.settings.facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.twitter_url != blank -%}
              <a href="{{ section.settings.twitter_url }}" aria-label="Twitter / X" target="_blank" rel="noopener">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.youtube_url != blank -%}
              <a href="{{ section.settings.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} Quick Links {%- endcomment -%}
        <div class="site-footer__col">
          <h4>Quick Links</h4>
          <ul class="site-footer__links">
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><a href="{{ routes.collections_url }}/all">Products</a></li>
            <li><a href="{{ routes.root_url }}#features">Features</a></li>
            <li><a href="{{ routes.root_url }}#about">About Us</a></li>
            <li><a href="{{ routes.root_url }}#contact">Contact</a></li>
          </ul>
        </div>

        {%- comment -%} Customer Service {%- endcomment -%}
        <div class="site-footer__col">
          <h4>Customer Service</h4>
          <ul class="site-footer__links">
            <li><a href="{{ section.settings.shipping_url | default: '#' }}">Shipping &amp; Delivery</a></li>
            <li><a href="{{ section.settings.returns_url | default: '#' }}">Returns &amp; Exchanges</a></li>
            <li><a href="{{ section.settings.warranty_url | default: '#' }}">Warranty Info</a></li>
            <li><a href="{{ section.settings.faq_url | default: '#' }}">FAQs</a></li>
            <li><a href="{{ section.settings.support_url | default: '#' }}">Support Center</a></li>
          </ul>
        </div>

        {%- comment -%} Contact Info {%- endcomment -%}
        <div class="site-footer__col">
          <h4>Contact Us</h4>
          <div>
            {%- if section.settings.address != blank -%}
              <div class="site-footer__contact-item">
                <svg class="icon site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{{ section.settings.address }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.phone != blank -%}
              <div class="site-footer__contact-item">
                <svg class="icon site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
              </div>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <div class="site-footer__contact-item">
                <svg class="icon site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>

      <div class="site-footer__bottom">
        <div class="site-footer__bottom-inner">
          <p class="site-footer__copyright">
            &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
          </p>
          <div class="site-footer__legal">
            {%- if section.settings.privacy_url != blank -%}
              <a href="{{ section.settings.privacy_url }}">Privacy Policy</a>
            {%- else -%}
              <a href="{{ shop.privacy_policy.url | default: '#' }}">Privacy Policy</a>
            {%- endif -%}
            {%- if section.settings.terms_url != blank -%}
              <a href="{{ section.settings.terms_url }}">Terms of Service</a>
            {%- else -%}
              <a href="{{ shop.terms_of_service.url | default: '#' }}">Terms of Service</a>
            {%- endif -%}
            <a href="{{ section.settings.cookie_url | default: '#' }}">Cookie Policy</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Company Info"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Leading the electric revolution with innovative, sustainable, and high-performance e-bikes."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "twitter_url", "label": "Twitter / X URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    {
      "type": "header",
      "content": "Contact Info"
    },
    { "type": "text", "id": "address", "label": "Address", "default": "123 E-Bike Street, Green City, EC 12345" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (234) 567-890" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@ebikes.com" },
    {
      "type": "header",
      "content": "Customer Service Links"
    },
    { "type": "url", "id": "shipping_url", "label": "Shipping & Delivery URL" },
    { "type": "url", "id": "returns_url", "label": "Returns & Exchanges URL" },
    { "type": "url", "id": "warranty_url", "label": "Warranty Info URL" },
    { "type": "url", "id": "faq_url", "label": "FAQs URL" },
    { "type": "url", "id": "support_url", "label": "Support Center URL" },
    {
      "type": "header",
      "content": "Legal Links"
    },
    { "type": "url", "id": "privacy_url", "label": "Privacy Policy URL" },
    { "type": "url", "id": "terms_url", "label": "Terms of Service URL" },
    { "type": "url", "id": "cookie_url", "label": "Cookie Policy URL" }
  ]
}
{% endschema %}
