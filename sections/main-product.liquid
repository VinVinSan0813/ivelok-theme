{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign badge           = product.metafields.custom.badge.value
  assign rating          = product.metafields.custom.rating.value | default: 0 | times: 1
  assign review_count    = product.metafields.custom.review_count.value | default: 0
  assign features        = product.metafields.custom.features.value
  assign motor           = product.metafields.specs.motor.value
  assign battery_spec    = product.metafields.specs.battery.value
  assign range_spec      = product.metafields.specs.range.value
  assign speed_spec      = product.metafields.specs.speed.value
  assign weight_spec     = product.metafields.specs.weight.value
  assign frame_spec      = product.metafields.specs.frame.value
  assign is_on_sale      = false
  if current_variant.compare_at_price > current_variant.price
    assign is_on_sale = true
  endif

  assign color_opt   = nil
  assign battery_opt = nil
  for opt in product.options_with_values
    assign opt_lower = opt.name | downcase
    if opt_lower == 'color' or opt_lower == 'colour'
      assign color_opt = opt
    endif
    if opt_lower == 'battery' or opt_lower == 'style' or opt_lower == 'type' or opt_lower == 'size'
      assign battery_opt = opt
    endif
  endfor
-%}

<div class="product-page">
  <div class="container">

    <a href="{{ routes.collections_url }}/all" class="product-back-link">
      <svg class="icon icon--sm" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m19 12-14 0"/><path d="m12 5-7 7 7 7"/>
      </svg>
      Back to Products
    </a>

    <div class="product-layout">

      <!-- ── Gallery ── -->
      <div class="animate-from-left">
        <div class="product-image-wrapper" style="position:relative;">
          {%- if is_on_sale -%}
            <span class="product-image-badge" style="background:#d4183d;">
              Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
            </span>
          {%- elsif badge != blank -%}
            <span class="product-image-badge">{{ badge }}</span>
          {%- endif -%}
          <img
            id="product-featured-image"
            src="{{ product.featured_image | image_url: width: 900 }}"
            srcset="{{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 900 }} 900w"
            sizes="(max-width:767px) 100vw, 50vw"
            alt="{{ product.featured_image.alt | escape | default: product.title }}"
            width="900" height="900"
            loading="eager"
            fetchpriority="high"
            style="width:100%;height:auto;display:block;border-radius:12px;object-fit:contain;background:#f7f7f7;"
          >
        </div>

        {%- if product.images.size > 1 -%}
          <div class="pdp-thumbs" id="pdp-thumbs">
            {%- for image in product.images -%}
              <button
                class="pdp-thumb{% if forloop.first %} is-active{% endif %}"
                data-full="{{ image | image_url: width: 900 }}"
                data-img-id="{{ image.id }}"
                type="button"
                aria-label="Image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 120 }}"
                  alt="{{ image.alt | escape | default: product.title }}"
                  width="120" height="120"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- ── Info ── -->
      <div class="animate-from-right">
        <div class="product-info__category">{{ product.type | default: product.tags.first }}</div>
        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__rating">
          {%- if rating > 0 -%}
            {%- render 'star-rating', rating: rating, review_count: review_count -%}
          {%- endif -%}
          <span id="pdp-stock-badge" class="{% if current_variant.available %}text-green{% else %}text-red{% endif %}"
            style="font-size:0.875rem;font-weight:600;">
            {% if current_variant.available %}In Stock{% else %}Out of Stock{% endif %}
          </span>
        </div>

        <div class="product-info__price">
          <span class="product-info__price-current" id="pdp-price">{{ current_variant.price | money }}</span>
          {%- if is_on_sale -%}
            <span class="product-info__price-original" id="pdp-compare-price">{{ current_variant.compare_at_price | money }}</span>
            <span class="product-info__price-save" id="pdp-save-badge">
              Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
            </span>
          {%- else -%}
            <span class="product-info__price-original" id="pdp-compare-price" style="display:none;"></span>
            <span class="product-info__price-save" id="pdp-save-badge" style="display:none;"></span>
          {%- endif -%}
        </div>

        {%- form 'product', product, id: 'product-form', novalidate: true -%}
          <input type="hidden" name="id"       id="pdp-variant-id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="pdp-qty-val"    value="1">

          <!-- Color swatches -->
          {%- if color_opt != blank -%}
            <div class="pdp-opt-group">
              <p class="pdp-opt-label">
                {{ color_opt.name }}:
                <strong id="pdp-color-label">{{ color_opt.selected_value }}</strong>
              </p>
              <div class="pdp-swatches" role="group" aria-label="Select {{ color_opt.name }}">
                {%- for val in color_opt.values -%}
                  {%- assign sw = val | downcase | replace: ' ', '' -%}
                  <button
                    type="button"
                    class="pdp-swatch{% if val == color_opt.selected_value %} is-active{% endif %}"
                    data-opt-name="{{ color_opt.name }}"
                    data-opt-val="{{ val }}"
                    style="background-color:{% case sw %}{% when 'green' %}#4a7c59{% when 'forestgreen' %}#3a6b47{% when 'white' %}#f5f5f0{% when 'black','onyxblack' %}#1c1c1e{% when 'grey','gray' %}#9ca3af{% when 'red' %}#dc2626{% when 'blue' %}#2563eb{% when 'gemblue' %}#29d9c2{% when 'navy' %}#1e3a5f{% when 'silver' %}#c0c0c0{% when 'orange' %}#EE731B{% when 'yellow','bumblebeeyellow' %}#eab308{% when 'purple' %}#7c3aed{% when 'brown' %}#92400e{% when 'pink' %}#ec4899{% when 'beige' %}#f5f0e8{% else %}#888{% endcase %};"
                    aria-label="{{ val }}"
                    aria-pressed="{% if val == color_opt.selected_value %}true{% else %}false{% endif %}"
                    title="{{ val }}"
                  ></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- Battery / other option pills -->
          {%- if battery_opt != blank -%}
            <div class="pdp-opt-group">
              <p class="pdp-opt-label">
                {{ battery_opt.name }}:
                <strong id="pdp-battery-label">{{ battery_opt.selected_value }}</strong>
              </p>
              <div class="pdp-pills" role="group" aria-label="Select {{ battery_opt.name }}">
                {%- for val in battery_opt.values -%}
                  <button
                    type="button"
                    class="pdp-pill{% if val == battery_opt.selected_value %} is-active{% endif %}"
                    data-opt-name="{{ battery_opt.name }}"
                    data-opt-val="{{ val }}"
                    aria-pressed="{% if val == battery_opt.selected_value %}true{% else %}false{% endif %}"
                  >{{ val }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- Fallback: other options that are neither color nor battery -->
          {%- for opt in product.options_with_values -%}
            {%- assign opt_lower = opt.name | downcase -%}
            {%- unless opt_lower == 'color' or opt_lower == 'colour' or opt_lower == 'battery' or opt_lower == 'style' or opt_lower == 'type' or opt_lower == 'size' -%}
              <div class="pdp-opt-group">
                <p class="pdp-opt-label">{{ opt.name }}: <strong>{{ opt.selected_value }}</strong></p>
                <div class="pdp-pills" role="group">
                  {%- for val in opt.values -%}
                    <button type="button"
                      class="pdp-pill{% if val == opt.selected_value %} is-active{% endif %}"
                      data-opt-name="{{ opt.name }}"
                      data-opt-val="{{ val }}"
                    >{{ val }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endunless -%}
          {%- endfor -%}

          <!-- Quantity + Add to Cart (side by side) -->
          <div class="pdp-purchase-row">
            <div class="quantity-selector" style="margin-bottom:0;">
              <div class="quantity-controls">
                <button type="button" class="quantity-btn quantity-btn--decrease" aria-label="Decrease">−</button>
                <span class="quantity-display" id="pdp-qty-display">1</span>
                <button type="button" class="quantity-btn quantity-btn--increase" aria-label="Increase">+</button>
              </div>
            </div>

            <div class="pdp-cart-col">
              {%- if current_variant.available -%}
                <button type="submit" class="btn-add-to-cart js-add-to-cart" id="pdp-add-btn"
                  aria-label="Add {{ product.title | escape }} to cart">
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  Add to Cart
                </button>
              {%- else -%}
                <button type="button" class="btn-add-to-cart" disabled>Sold Out</button>
              {%- endif -%}
            </div>
          </div>
          {%- if current_variant.available -%}
            <button type="submit" name="checkout" class="btn-buy-now">Buy it now</button>
          {%- endif -%}

        {%- endform -%}

        <!-- Benefits -->
        <div class="product-benefits">
          <div class="benefit-item">
            <svg class="icon benefit-item__icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="1" y="3" width="15" height="13"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <div>
              <div class="benefit-item__title">Free EU Shipping</div>
              <div class="benefit-item__subtitle">All orders</div>
            </div>
          </div>
          <div class="benefit-item">
            <svg class="icon benefit-item__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <div>
              <div class="benefit-item__title">2-Year Warranty</div>
              <div class="benefit-item__subtitle">Full coverage</div>
            </div>
          </div>
          <div class="benefit-item">
            <svg class="icon benefit-item__icon" viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"/>
              <path d="M3.51 15a9 9 0 1 0 .49-4.95"/>
            </svg>
            <div>
              <div class="benefit-item__title">14-Day Returns</div>
              <div class="benefit-item__subtitle">EU consumer rights</div>
            </div>
          </div>
        </div>
      </div><!-- /animate-from-right -->
    </div><!-- /product-layout -->



  </div>
</div>

{%- assign detail_images_pc = product.metafields.custom.detail_images_pc.value -%}
{%- if detail_images_pc != blank -%}
  <div id="product-detail-images">
    {%- for img in detail_images_pc -%}
      <img
        src="{{ img | image_url: width: 1920 }}"
        alt="{{ product.title | escape }} detail {{ forloop.index }}"
        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
        width="1920"
      >
    {%- endfor -%}
  </div>
{%- endif -%}

<script>
(function () {
  /* ── Data ── */
  var VARIANTS = {{ product.variants | json }};
  var MONEY_FORMAT = {{ shop.money_format | json }};

  /* Build variant-id → featured-image URL map using Liquid-generated URLs */
  var VARIANT_IMG_MAP = {
    {%- for variant in product.variants -%}
      {%- if variant.featured_image -%}
        {{ variant.id }}: {{ variant.featured_image | image_url: width: 900 | json }}{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  };

  /* Build image-id → CDN URL map from thumbnail buttons */
  var IMG_ID_URL_MAP = {};
  document.querySelectorAll('#pdp-thumbs .pdp-thumb').forEach(function (btn) {
    IMG_ID_URL_MAP[btn.dataset.imgId] = btn.dataset.full;
  });

  /* Track selected options */
  var selectedOpts = {};
  {{ product.options_with_values | json }}.forEach(function (opt) {
    selectedOpts[opt.name] = opt.selected_value;
  });

  /* ── Thumbnail click ── */
  var thumbsContainer = document.getElementById('pdp-thumbs');
  if (thumbsContainer) {
    thumbsContainer.addEventListener('click', function (e) {
      var btn = e.target.closest('.pdp-thumb');
      if (!btn) return;
      setMainImg(btn.dataset.full);
      setActiveThumb(btn.dataset.imgId);
    });
  }

  /* ── Qty buttons ── */
  document.querySelector('.quantity-btn--decrease') &&
    document.querySelector('.quantity-btn--decrease').addEventListener('click', function () { changeQty(-1); });
  document.querySelector('.quantity-btn--increase') &&
    document.querySelector('.quantity-btn--increase').addEventListener('click', function () { changeQty(1); });

  function changeQty(delta) {
    var display = document.getElementById('pdp-qty-display');
    var input   = document.getElementById('pdp-qty-val');
    if (!display || !input) return;
    var n = Math.max(1, parseInt(display.textContent) + delta);
    display.textContent = n;
    input.value = n;
  }

  /* ── Option buttons (swatches + pills) ── */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.pdp-swatch, .pdp-pill');
    if (!btn) return;

    var optName = btn.dataset.optName;
    var optVal  = btn.dataset.optVal;
    selectedOpts[optName] = optVal;

    /* Deselect siblings */
    btn.closest('.pdp-swatches, .pdp-pills').querySelectorAll('button').forEach(function (b) {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');

    /* Update visible label */
    var isColor = optName.toLowerCase() === 'color' || optName.toLowerCase() === 'colour';
    var labelId = isColor ? 'pdp-color-label' : 'pdp-battery-label';
    var lbl = document.getElementById(labelId);
    if (lbl) lbl.textContent = optVal;

    /* Find matching variant */
    var match = findVariant();
    if (!match) return;

    /* Update hidden input */
    document.getElementById('pdp-variant-id').value = match.id;

    /* Update price */
    updatePrice(match);

    /* Update stock */
    updateStock(match);

    /* Color → image switch */
    if (isColor) {
      var imgUrl = VARIANT_IMG_MAP[match.id];
      if (imgUrl) {
        setMainImg(imgUrl);
        /* Highlight matching thumbnail */
        if (match.featured_image) {
          setActiveThumb(String(match.featured_image.id));
        }
      }
    }
  });

  function findVariant() {
    return VARIANTS.find(function (v) {
      return v.options.every(function (opt, i) {
        var name = {{ product.options | json }}[i];
        return !selectedOpts[name] || selectedOpts[name] === opt;
      });
    });
  }

  function setMainImg(url) {
    var img = document.getElementById('product-featured-image');
    if (!img) return;
    img.srcset = '';
    img.src = url;
  }

  function setActiveThumb(imgId) {
    document.querySelectorAll('.pdp-thumb').forEach(function (th) {
      var active = th.dataset.imgId === String(imgId);
      th.classList.toggle('is-active', active);
      if (active) th.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    });
  }

  function updatePrice(variant) {
    var priceEl   = document.getElementById('pdp-price');
    var compareEl = document.getElementById('pdp-compare-price');
    var saveEl    = document.getElementById('pdp-save-badge');

    if (priceEl) priceEl.textContent = formatMoney(variant.price);

    if (compareEl && saveEl) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        compareEl.textContent = formatMoney(variant.compare_at_price);
        compareEl.style.display = '';
        saveEl.textContent = 'Save ' + formatMoney(variant.compare_at_price - variant.price);
        saveEl.style.display = '';
      } else {
        compareEl.style.display = 'none';
        saveEl.style.display = 'none';
      }
    }
  }

  function updateStock(variant) {
    var el = document.getElementById('pdp-stock-badge');
    if (!el) return;
    el.textContent = variant.available ? 'In Stock' : 'Out of Stock';
    el.className   = variant.available ? 'text-green' : 'text-red';
    el.style.cssText = 'font-size:0.875rem;font-weight:600;';
  }

  function formatMoney(cents) {
    var amount = (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return MONEY_FORMAT.replace('{{amount}}', amount)
      .replace('{{amount_with_comma_separator}}', amount)
      .replace('{{amount_no_decimals}}', Math.round(cents / 100))
      .replace('{{amount_no_decimals_with_comma_separator}}', Math.round(cents / 100));
  }
}());
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
