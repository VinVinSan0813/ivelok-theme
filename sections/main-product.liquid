{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign badge = product.metafields.custom.badge.value
  assign rating = product.metafields.custom.rating.value | default: 0 | times: 1
  assign review_count = product.metafields.custom.review_count.value | default: 0
  assign features = product.metafields.custom.features.value
  assign motor = product.metafields.specs.motor.value
  assign battery = product.metafields.specs.battery.value
  assign range = product.metafields.specs.range.value
  assign speed = product.metafields.specs.speed.value
  assign weight = product.metafields.specs.weight.value
  assign frame = product.metafields.specs.frame.value
  assign is_on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign is_on_sale = true
    assign savings = current_variant.compare_at_price | minus: current_variant.price
    assign discount_pct = savings | times: 100 | divided_by: current_variant.compare_at_price | round
  endif
-%}

<div class="product-page">

  {%- comment -%} Breadcrumb {%- endcomment -%}
  <div class="product-breadcrumb">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </span>
        <a href="{{ routes.collections_url }}/all" class="breadcrumb-link">E-Bikes</a>
        <span class="breadcrumb-sep">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </span>
        <span class="breadcrumb-current">{{ product.title }}</span>
      </nav>
    </div>
  </div>

  <div class="product-inner">
    <div class="container">

      {%- comment -%} Product Layout {%- endcomment -%}
      <div class="product-layout">

        {%- comment -%} ── Left: Image Gallery ── {%- endcomment -%}
        <div class="product-gallery animate-from-left">

          {%- comment -%} Main Image {%- endcomment -%}
          <div class="gallery-main">
            {%- if product.featured_image != blank -%}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | escape | default: product.title }}"
                id="product-main-image"
                width="800"
                loading="eager"
              >
            {%- else -%}
              <img
                src="{{ product.metafields.custom.image_url.value | default: 'https://images.unsplash.com/photo-1668106601849-e21e72c2c563?fit=max&w=800&q=80' }}"
                alt="{{ product.title | escape }}"
                id="product-main-image"
                width="800"
                loading="eager"
              >
            {%- endif -%}

            {%- if badge != blank -%}
              <span class="product-image-badge">{{ badge }}</span>
            {%- endif -%}

            {%- if is_on_sale -%}
              <span class="product-discount-badge">-{{ discount_pct }}%</span>
            {%- endif -%}

            <button class="gallery-arrow gallery-arrow--prev" aria-label="Previous image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6"/>
              </svg>
            </button>
            <button class="gallery-arrow gallery-arrow--next" aria-label="Next image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </button>

            {%- if product.images.size > 1 -%}
              <div class="gallery-dots">
                {%- for image in product.images -%}
                  <button
                    class="gallery-dot{% if forloop.first %} is-active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    aria-label="Go to image {{ forloop.index }}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} Thumbnails {%- endcomment -%}
          {%- if product.images.size > 1 -%}
            <div class="product-thumbnails">
              {%- for image in product.images -%}
                <button
                  class="product-thumbnail{% if forloop.first %} is-active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-full="{{ image | image_url: width: 800 }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ image.alt | escape | default: product.title }}"
                    loading="lazy"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} ── Right: Product Info ── {%- endcomment -%}
        <div class="product-info animate-from-right">

          <div>
            <div class="product-info__category">{{ product.type | default: product.tags.first }} E-Bike</div>
            <h1 class="product-info__title">{{ product.title }}</h1>
          </div>

          <div class="product-info__rating">
            {%- if rating > 0 -%}
              {%- render 'star-rating', rating: rating, review_count: review_count -%}
            {%- endif -%}
            {%- if current_variant.available -%}
              <span class="stock-badge stock-badge--in">✓ In Stock</span>
            {%- else -%}
              <span class="stock-badge stock-badge--out">Out of Stock</span>
            {%- endif -%}
          </div>

          <div class="product-info__price">
            <span class="product-info__price-current" id="product-price">{{ current_variant.price | money }}</span>
            {%- if is_on_sale -%}
              <span class="product-info__price-original" id="product-compare-price">{{ current_variant.compare_at_price | money }}</span>
              <span class="product-info__price-save" id="product-savings">Save {{ savings | money }}</span>
            {%- endif -%}
          </div>

          {%- comment -%} Variant Options {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name_lower = option.name | downcase -%}
              <div class="product-option">
                <p class="option-label">
                  {{ option.name }}:
                  <span class="js-option-label-{{ forloop.index }}">{{ option.selected_value }}</span>
                </p>
                {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
                  <div class="color-swatches">
                    {%- for value in option.values -%}
                      <button
                        class="color-swatch{% if value == option.selected_value %} is-active{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-option-value="{{ value }}"
                        title="{{ value }}"
                        style="background-color: {{ value | downcase }};"
                        aria-label="{{ value }}"
                      ></button>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="option-pills">
                    {%- for value in option.values -%}
                      <button
                        class="option-pill{% if value == option.selected_value %} is-active{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-option-value="{{ value }}"
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}

          {%- comment -%} Form {%- endcomment -%}
          {%- form 'product', product, id: 'product-form' -%}
            <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">

            <div class="product-quantity-row">
              <div class="quantity-selector">
                <label>Quantity</label>
                <div class="quantity-controls">
                  <button type="button" class="quantity-btn quantity-btn--decrease" aria-label="Decrease quantity">−</button>
                  <span class="quantity-display">1</span>
                  <button type="button" class="quantity-btn quantity-btn--increase" aria-label="Increase quantity">+</button>
                </div>
                <input type="hidden" name="quantity" value="1">
              </div>

              <div class="product-actions">
              {%- if current_variant.available -%}
                <button type="submit" class="btn-add-to-cart js-add-to-cart" aria-label="Add to cart">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  Add to Cart
                </button>
              {%- else -%}
                <button type="button" class="btn-add-to-cart" disabled>Sold Out</button>
              {%- endif -%}
              <div class="product-actions-row">
                <button type="button" class="btn-buy-now js-buy-now">Buy Now</button>
                <button type="button" class="product-wishlist-btn js-wishlist" aria-label="Add to wishlist">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>
              </div>
            </div>
            </div>
          {%- endform -%}

          {%- comment -%} Trust Badges {%- endcomment -%}
          <div class="product-benefits">
            <div class="benefit-item">
              <div class="benefit-item__icon-wrap">
                <svg class="benefit-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              </div>
              <div>
                <div class="benefit-item__title">Free Shipping</div>
                <div class="benefit-item__subtitle">Orders over $1,000</div>
              </div>
            </div>
            <div class="benefit-item">
              <div class="benefit-item__icon-wrap">
                <svg class="benefit-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <div>
                <div class="benefit-item__title">2-Year Warranty</div>
                <div class="benefit-item__subtitle">Full coverage</div>
              </div>
            </div>
            <div class="benefit-item">
              <div class="benefit-item__icon-wrap">
                <svg class="benefit-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="1 4 1 10 7 10"/>
                  <path d="M3.51 15a9 9 0 1 0 .49-4.95"/>
                </svg>
              </div>
              <div>
                <div class="benefit-item__title">30-Day Returns</div>
                <div class="benefit-item__subtitle">Money back</div>
              </div>
            </div>
          </div>

          {%- comment -%} Payment Methods {%- endcomment -%}
          <div class="payment-methods">
            <span class="payment-methods__label">Secure payment:</span>
            <span class="payment-badge" style="background:#1a1f71;color:#fff;">VISA</span>
            <span class="payment-badge" style="background:#eb001b;color:#fff;">MC</span>
            <span class="payment-badge" style="background:#003087;color:#fff;">PayPal</span>
            <span class="payment-badge" style="background:#ffb3c7;color:#1a1a1a;">Klarna</span>
            <span class="payment-badge" style="background:#2e77bc;color:#fff;">AMEX</span>
          </div>

        </div>
      </div>

      {%- comment -%} ── Tabs ── {%- endcomment -%}
      <div class="product-tabs">
        <div class="product-tabs__nav">
          <button class="product-tab-btn is-active" data-tab="description">Description</button>
          <button class="product-tab-btn" data-tab="specs">Specifications</button>
          <button class="product-tab-btn" data-tab="shipping">Shipping &amp; Returns</button>
        </div>

        {%- comment -%} Description Tab {%- endcomment -%}
        <div class="product-tab-panel is-active" data-tab="description">
          <div class="description-layout">
            <div>
              {%- if product.description != blank -%}
                <p class="description-text">{{ product.description | strip_html }}</p>
              {%- endif -%}
              {%- if features != blank -%}
                <h3 class="product-features__title">Key Features</h3>
                <ul class="product-features__list">
                  {%- for feature in features -%}
                    <li class="product-features__item">
                      <span class="product-features__check-wrap">
                        <svg class="product-features__check" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span class="product-features__text">{{ feature }}</span>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif product.tags.size > 0 -%}
                <h3 class="product-features__title">Key Features</h3>
                <ul class="product-features__list">
                  {%- for tag in product.tags -%}
                    {%- unless tag contains ':' -%}
                      <li class="product-features__item">
                        <span class="product-features__check-wrap">
                          <svg class="product-features__check" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span class="product-features__text">{{ tag }}</span>
                      </li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

            {%- if motor or battery or range or speed or weight or frame -%}
              <div class="quick-specs-card">
                <h3 class="quick-specs-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                  Quick Specs
                </h3>
                <div>
                  {%- if motor != blank -%}<div class="spec-row"><span class="spec-row__key">Motor</span><span class="spec-row__value">{{ motor }}</span></div>{%- endif -%}
                  {%- if battery != blank -%}<div class="spec-row"><span class="spec-row__key">Battery</span><span class="spec-row__value">{{ battery }}</span></div>{%- endif -%}
                  {%- if range != blank -%}<div class="spec-row"><span class="spec-row__key">Range</span><span class="spec-row__value">{{ range }}</span></div>{%- endif -%}
                  {%- if speed != blank -%}<div class="spec-row"><span class="spec-row__key">Speed</span><span class="spec-row__value">{{ speed }}</span></div>{%- endif -%}
                  {%- if weight != blank -%}<div class="spec-row"><span class="spec-row__key">Weight</span><span class="spec-row__value">{{ weight }}</span></div>{%- endif -%}
                  {%- if frame != blank -%}<div class="spec-row"><span class="spec-row__key">Frame</span><span class="spec-row__value">{{ frame }}</span></div>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} Specifications Tab {%- endcomment -%}
        <div class="product-tab-panel" data-tab="specs">
          {%- if motor or battery or range or speed or weight or frame -%}
            <div class="specs-grid">
              {%- if motor != blank -%}<div class="spec-row"><span class="spec-row__key">Motor</span><span class="spec-row__value">{{ motor }}</span></div>{%- endif -%}
              {%- if battery != blank -%}<div class="spec-row"><span class="spec-row__key">Battery</span><span class="spec-row__value">{{ battery }}</span></div>{%- endif -%}
              {%- if range != blank -%}<div class="spec-row"><span class="spec-row__key">Range</span><span class="spec-row__value">{{ range }}</span></div>{%- endif -%}
              {%- if speed != blank -%}<div class="spec-row"><span class="spec-row__key">Speed</span><span class="spec-row__value">{{ speed }}</span></div>{%- endif -%}
              {%- if weight != blank -%}<div class="spec-row"><span class="spec-row__key">Weight</span><span class="spec-row__value">{{ weight }}</span></div>{%- endif -%}
              {%- if frame != blank -%}<div class="spec-row"><span class="spec-row__key">Frame</span><span class="spec-row__value">{{ frame }}</span></div>{%- endif -%}
            </div>
          {%- else -%}
            <p style="color:#6b7280;">No specifications available.</p>
          {%- endif -%}
        </div>

        {%- comment -%} Shipping Tab {%- endcomment -%}
        <div class="product-tab-panel" data-tab="shipping">
          <div class="shipping-grid">
            <div class="shipping-card">
              <div class="shipping-card__header">
                <div class="shipping-card__icon-wrap">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                </div>
                <h3 class="shipping-card__title">Shipping Information</h3>
              </div>
              <ul class="shipping-list">
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Free shipping on orders over $1,000</li>
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Standard delivery: 5–7 business days</li>
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Express delivery: 2–3 business days</li>
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Fully insured with tracking</li>
              </ul>
            </div>
            <div class="shipping-card">
              <div class="shipping-card__header">
                <div class="shipping-card__icon-wrap">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="1 4 1 10 7 10"/>
                    <path d="M3.51 15a9 9 0 1 0 .49-4.95"/>
                  </svg>
                </div>
                <h3 class="shipping-card__title">Returns &amp; Warranty</h3>
              </div>
              <ul class="shipping-list">
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> 30-day money-back guarantee</li>
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> 2-year manufacturer warranty</li>
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Product must be in original condition</li>
                <li><svg class="shipping-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Free return shipping on defective items</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script id="product-variant-json" type="application/json">
  {{ product.variants | json }}
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
