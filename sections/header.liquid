<header class="site-header" role="banner">
  <div class="container">
    <div class="site-header__inner">

      {%- comment -%} Logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="site-header__logo">
        <div class="site-header__logo-icon">
          <span>E</span>
        </div>
        <span class="site-header__logo-text">{{ shop.name | upcase | default: 'E-BIKES' }}</span>
      </a>

      {%- comment -%} Desktop Navigation {%- endcomment -%}
      <nav class="site-header__nav" role="navigation" aria-label="Main navigation">
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.collections_url }}/all">Products</a>
        <a href="{{ routes.root_url }}#features">Features</a>
        <a href="{{ routes.root_url }}#about">About</a>
        <a href="{{ routes.root_url }}#contact">Contact</a>
      </nav>

      {%- comment -%} Desktop Actions {%- endcomment -%}
      <div class="site-header__actions">
        <a href="{{ routes.search_url }}" class="site-header__icon-btn" aria-label="Search">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
        </a>
        <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="Account">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
        <a href="{{ routes.cart_url }}" class="site-header__icon-btn" aria-label="Cart ({{ cart.item_count }} items)">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="site-header__cart-badge {% if cart.item_count == 0 %}site-header__cart-badge--hidden{% endif %}">
            {{ cart.item_count }}
          </span>
        </a>
      </div>

      {%- comment -%} Mobile Toggle {%- endcomment -%}
      <button class="site-header__mobile-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="icon icon--lg js-menu-icon-open" viewBox="0 0 24 24" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon icon--lg js-menu-icon-close" viewBox="0 0 24 24" aria-hidden="true" style="display:none">
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>
  </div>

  {%- comment -%} Mobile Menu {%- endcomment -%}
  <div class="site-header__mobile-menu" id="mobile-menu" role="navigation" aria-label="Mobile navigation">
    <nav class="site-header__mobile-nav">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.collections_url }}/all">Products</a>
      <a href="{{ routes.root_url }}#features">Features</a>
      <a href="{{ routes.root_url }}#about">About</a>
      <a href="{{ routes.root_url }}#contact">Contact</a>
      <div class="site-header__mobile-actions">
        <a href="{{ routes.search_url }}" class="site-header__icon-btn" aria-label="Search">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
        <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="Account">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" class="site-header__icon-btn" aria-label="Cart">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="site-header__cart-badge {% if cart.item_count == 0 %}site-header__cart-badge--hidden{% endif %}">
            {{ cart.item_count }}
          </span>
        </a>
      </div>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
