<div class="cart-page">
  <div class="container">
    <h1>Your Cart</h1>

    {%- if cart.item_count > 0 -%}
      <div class="cart-layout">
        {%- comment -%} Cart Items {%- endcomment -%}
        <div class="cart-items">
          {%- for item in cart.items -%}
            <div class="cart-item">
              <div class="cart-item__image">
                {%- if item.image != blank -%}
                  <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.image.alt | escape }}">
                {%- endif -%}
              </div>
              <div class="cart-item__details">
                <h3 class="cart-item__title">{{ item.product.title }}</h3>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p style="font-size:0.75rem;color:#6b7280;margin-bottom:0.25rem;">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item__price">{{ item.final_price | money }} each</p>
                <div class="cart-item__actions">
                  <div class="quantity-controls" style="transform:scale(0.9);transform-origin:left;">
                    <button type="button" class="quantity-btn quantity-btn--decrease" aria-label="Decrease">−</button>
                    <span class="quantity-display">{{ item.quantity }}</span>
                    <button type="button" class="quantity-btn quantity-btn--increase" aria-label="Increase">+</button>
                    <input type="hidden" class="js-cart-qty" data-key="{{ item.key }}" value="{{ item.quantity }}">
                  </div>
                  <button
                    class="js-cart-remove"
                    data-key="{{ item.key }}"
                    style="font-size:0.75rem;color:#dc2626;background:none;border:none;cursor:pointer;padding:0.25rem 0;"
                    aria-label="Remove {{ item.product.title | escape }}"
                  >
                    Remove
                  </button>
                </div>
              </div>
              <div style="text-align:right;font-weight:700;white-space:nowrap;">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Cart Summary {%- endcomment -%}
        <div class="cart-summary">
          <h2>Order Summary</h2>
          <div class="cart-summary__row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary__row">
            <span>Shipping</span>
            <span>Calculated at checkout</span>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <a href="/checkout" class="cart-checkout-btn">
            Proceed to Checkout
          </a>
          <a
            href="{{ routes.collections_url }}/all"
            class="btn btn--outline"
            style="width:100%;margin-top:0.75rem;justify-content:center;"
          >
            Continue Shopping
          </a>
        </div>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.collections_url }}/all" class="btn btn--primary">
          Start Shopping
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
