{%- comment -%} YouTube M20 Landing Page Section {%- endcomment -%}
<style>
/* ===== RESET & BASE ===== */
#lp-wrap *{box-sizing:border-box;margin:0;padding:0}
#lp-wrap{font-family:'Inter',sans-serif;background:#0C0C0C;color:#fff;width:100%;overflow-x:hidden}
#lp-wrap a{text-decoration:none;color:inherit}
#lp-wrap img{max-width:100%;display:block}

/* ===== ANNOUNCEMENT BAR ===== */
#lp-bar{background:#FF5500;color:#fff;text-align:center;padding:10px 16px;font-size:14px;font-weight:600;letter-spacing:.5px}

/* ===== HERO ===== */
#lp-hero{position:relative;min-height:92vh;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0C0C0C}
#lp-hero-bg{position:absolute;inset:0;background:url('https://sc01.alicdn.com/kf/A67865f633865483fa5ef48640831395fS.png') center/cover no-repeat;opacity:.45;z-index:0}
#lp-hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(12,12,12,.2) 0%,rgba(12,12,12,.85) 100%);z-index:1}
#lp-hero-content{position:relative;z-index:2;text-align:center;padding:40px 20px;max-width:800px}
#lp-hero-content h1{font-family:'Barlow Condensed',sans-serif;font-size:clamp(38px,7vw,72px);font-weight:900;line-height:1.05;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}
#lp-hero-content h1 span{color:#FF5500}
#lp-hero-content p{font-size:clamp(15px,2.5vw,18px);color:#ccc;margin-bottom:32px;line-height:1.6}
.lp-btn{display:inline-block;background:#FF5500;color:#fff;font-weight:700;font-size:17px;padding:16px 40px;border-radius:4px;letter-spacing:.5px;transition:background .2s;border:none;cursor:pointer;text-transform:uppercase}
.lp-btn:hover{background:#e04a00}

/* ===== TRUST BAR ===== */
#lp-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:0;background:#161616;border-top:1px solid #222;border-bottom:1px solid #222}
.lp-trust-item{flex:1 1 200px;text-align:center;padding:22px 16px;border-right:1px solid #222}
.lp-trust-item:last-child{border-right:none}
.lp-trust-icon{font-size:26px;margin-bottom:6px}
.lp-trust-label{font-size:13px;color:#aaa;font-weight:500;line-height:1.4}
.lp-trust-label strong{display:block;color:#fff;font-size:15px;margin-bottom:2px}

/* ===== PRODUCT SHOWCASE ===== */
#lp-showcase{display:flex;flex-wrap:wrap;align-items:center;gap:48px;padding:80px 5%;max-width:1200px;margin:0 auto}
#lp-showcase-img{flex:1 1 340px}
#lp-showcase-img img{border-radius:8px;width:100%}
#lp-showcase-text{flex:1 1 320px}
#lp-showcase-text h2{font-family:'Barlow Condensed',sans-serif;font-size:clamp(28px,5vw,48px);font-weight:900;text-transform:uppercase;line-height:1.1;margin-bottom:32px}
#lp-showcase-text h2 span{color:#FF5500}
.lp-feature{display:flex;gap:16px;margin-bottom:28px;align-items:flex-start}
.lp-feature-icon{flex-shrink:0;width:44px;height:44px;background:#FF5500;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:20px}
.lp-feature-body strong{display:block;font-size:16px;margin-bottom:4px}
.lp-feature-body span{font-size:14px;color:#999;line-height:1.5}

/* ===== EMAIL CAPTURE ===== */
#lp-email{background:#111;border-top:1px solid #222;border-bottom:1px solid #222;padding:80px 5%;text-align:center}
#lp-email h2{font-family:'Barlow Condensed',sans-serif;font-size:clamp(28px,5vw,52px);font-weight:900;text-transform:uppercase;margin-bottom:12px}
#lp-email h2 span{color:#FF5500}
#lp-email p{color:#aaa;font-size:15px;margin-bottom:36px}
#lp-form{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;max-width:560px;margin:0 auto}
#lp-form input{flex:1 1 200px;padding:14px 18px;background:#1a1a1a;border:1px solid #333;border-radius:4px;color:#fff;font-size:15px;outline:none}
#lp-form input:focus{border-color:#FF5500}
#lp-form input::placeholder{color:#666}
#lp-form-btn{background:#FF5500;color:#fff;font-weight:700;font-size:15px;padding:14px 28px;border:none;border-radius:4px;cursor:pointer;text-transform:uppercase;white-space:nowrap}
#lp-form-btn:hover{background:#e04a00}
#lp-success{display:none;margin-top:24px;background:#1a2a1a;border:1px solid #2d5a2d;border-radius:8px;padding:24px;max-width:480px;margin-left:auto;margin-right:auto}
#lp-success h3{color:#4CAF50;font-size:20px;margin-bottom:8px}
#lp-success p{color:#ccc;font-size:15px}
#lp-success .lp-code{display:inline-block;background:#FF5500;color:#fff;font-size:22px;font-weight:900;letter-spacing:3px;padding:10px 24px;border-radius:4px;margin:12px 0}

/* ===== SOCIAL PROOF ===== */
#lp-reviews{padding:80px 5%;max-width:1100px;margin:0 auto;text-align:center}
#lp-reviews h2{font-family:'Barlow Condensed',sans-serif;font-size:clamp(26px,4vw,44px);font-weight:900;text-transform:uppercase;margin-bottom:48px}
#lp-reviews h2 span{color:#FF5500}
.lp-review-grid{display:flex;flex-wrap:wrap;gap:24px;justify-content:center}
.lp-review-card{flex:1 1 280px;max-width:340px;background:#111;border:1px solid #222;border-radius:8px;padding:28px 24px;text-align:left}
.lp-stars{color:#FF5500;font-size:18px;margin-bottom:10px}
.lp-review-text{font-size:14px;color:#ccc;line-height:1.6;margin-bottom:16px}
.lp-reviewer{font-size:13px;color:#666;font-weight:600}

/* ===== FINAL CTA ===== */
#lp-cta{background:#FF5500;text-align:center;padding:70px 20px}
#lp-cta h2{font-family:'Barlow Condensed',sans-serif;font-size:clamp(28px,5vw,52px);font-weight:900;text-transform:uppercase;margin-bottom:16px;color:#fff}
#lp-cta p{color:rgba(255,255,255,.85);font-size:16px;margin-bottom:32px}
.lp-btn-dark{display:inline-block;background:#0C0C0C;color:#fff;font-weight:700;font-size:17px;padding:16px 44px;border-radius:4px;letter-spacing:.5px;transition:background .2s;text-transform:uppercase}
.lp-btn-dark:hover{background:#222}

/* ===== FOOTER NOTE ===== */
#lp-footer{background:#0C0C0C;border-top:1px solid #1a1a1a;text-align:center;padding:20px;font-size:12px;color:#444}

@media(max-width:600px){
  #lp-trust{flex-direction:column}
  .lp-trust-item{border-right:none;border-bottom:1px solid #222}
  #lp-showcase{flex-direction:column;padding:48px 20px}
}
</style>

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div id="lp-wrap">

  <!-- ANNOUNCEMENT BAR -->
  <div id="lp-bar">🔥 Limited Offer — Get 10% Off Your First Ride &nbsp;|&nbsp; Free Shipping on Orders Over $99</div>

  <!-- HERO -->
  <section id="lp-hero">
    <div id="lp-hero-bg"></div>
    <div id="lp-hero-overlay"></div>
    <div id="lp-hero-content">
      <h1>As Reviewed on YouTube.<br><span>Now It's Your Turn.</span></h1>
      <p>ENGWE M20 — Dual Suspension Fat Tire Ebike &nbsp;·&nbsp; Up to 150km Range &nbsp;·&nbsp; 75Nm Torque</p>
      <a href="#lp-email" class="lp-btn">Claim Your 10% Off &rarr;</a>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div id="lp-trust">
    <div class="lp-trust-item">
      <div class="lp-trust-icon">✅</div>
      <div class="lp-trust-label"><strong>CE Certified</strong>Safety Compliant</div>
    </div>
    <div class="lp-trust-item">
      <div class="lp-trust-icon">⚡</div>
      <div class="lp-trust-label"><strong>75Nm Torque</strong>Powerful Motor</div>
    </div>
    <div class="lp-trust-item">
      <div class="lp-trust-icon">🛞</div>
      <div class="lp-trust-label"><strong>Fat Tire + Dual Suspension</strong>Any Terrain</div>
    </div>
    <div class="lp-trust-item">
      <div class="lp-trust-icon">🚀</div>
      <div class="lp-trust-label"><strong>Up to 150km</strong>Per Charge</div>
    </div>
  </div>

  <!-- PRODUCT SHOWCASE -->
  <section>
    <div id="lp-showcase">
      <div id="lp-showcase-img">
        <img src="https://sc01.alicdn.com/kf/Aaa61585021a74bc185c7690dc51c4613X.png" alt="ENGWE M20 Dual Suspension Ebike">
      </div>
      <div id="lp-showcase-text">
        <h2>The Bike That<br><span>Passes Every Test</span></h2>
        <div class="lp-feature">
          <div class="lp-feature-icon">🔧</div>
          <div class="lp-feature-body">
            <strong>Dual Suspension System</strong>
            <span>Front hydraulic + rear air shock — 2x more absorption than standard ebikes. Verified by reviewers on every terrain.</span>
          </div>
        </div>
        <div class="lp-feature">
          <div class="lp-feature-icon">🛞</div>
          <div class="lp-feature-body">
            <strong>4" Fat Tires</strong>
            <span>Maximum grip and stability on any surface — sand, snow, mud, or pavement. No terrain is off-limits.</span>
          </div>
        </div>
        <div class="lp-feature">
          <div class="lp-feature-icon">🔋</div>
          <div class="lp-feature-body">
            <strong>150km Range on a Single Charge</strong>
            <span>Dual battery option extends your ride further. Real-world tested range confirmed by independent reviewers.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EMAIL CAPTURE -->
  <section id="lp-email">
    <h2>Get <span>10% Off</span> + Free Shipping</h2>
    <p>Enter your email and we'll send your exclusive discount code instantly.</p>
    <div id="lp-form">
      <input type="text" id="lp-name" placeholder="Your Name" autocomplete="name">
      <input type="email" id="lp-mail" placeholder="Your Email Address" autocomplete="email">
      <button id="lp-form-btn" onclick="lpSubmit()">Send Me the Code</button>
    </div>
    <div id="lp-success">
      <h3>🎉 Your Code is Ready!</h3>
      <p>Use this code at checkout for 10% off your ENGWE M20:</p>
      <div class="lp-code">RIDE10</div>
      <p style="margin-top:8px;font-size:13px;color:#888">We've also sent it to your email. Valid for 7 days.</p>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section id="lp-reviews">
    <h2>What Riders Are <span>Saying</span></h2>
    <div class="lp-review-grid">
      <div class="lp-review-card">
        <div class="lp-stars">★★★★★</div>
        <p class="lp-review-text">"Watched 4 YouTube reviews before buying. Every single reviewer was right — the suspension is insane. This bike handles everything I throw at it."</p>
        <div class="lp-reviewer">— Daniel R., Texas</div>
      </div>
      <div class="lp-review-card">
        <div class="lp-stars">★★★★★</div>
        <p class="lp-review-text">"The YouTube review sold me on the range. 90 miles on one charge in real conditions. Build quality is premium — this is not a toy, it's a serious machine."</p>
        <div class="lp-reviewer">— Priya S., California</div>
      </div>
      <div class="lp-review-card">
        <div class="lp-stars">★★★★★</div>
        <p class="lp-review-text">"Worth every penny. The fat tires and dual suspension make my mountain trail commute actually enjoyable. Fast delivery, great packaging, zero issues."</p>
        <div class="lp-reviewer">— Chris W., Montana</div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="lp-cta">
    <h2>Ready to Ride?</h2>
    <p>Limited stock available — don't miss your 10% off with code RIDE10</p>
    <a href="/products/engwe-m20" class="lp-btn-dark">Shop ENGWE M20 Now &rarr;</a>
  </section>

  <div id="lp-footer">© 2026 iVelok. All rights reserved. &nbsp;|&nbsp; <a href="/policies/privacy-policy" style="color:#555">Privacy Policy</a></div>

</div>

<script>
function lpSubmit(){
  var name = document.getElementById('lp-name').value.trim();
  var email = document.getElementById('lp-mail').value.trim();
  if(!email || !email.includes('@')){
    alert('Please enter a valid email address.');
    return;
  }
  document.getElementById('lp-form').style.display='none';
  document.getElementById('lp-success').style.display='block';
}
document.querySelectorAll('a[href^="#"]').forEach(function(a){
  a.addEventListener('click',function(e){
    e.preventDefault();
    var target=document.querySelector(this.getAttribute('href'));
    if(target) target.scrollIntoView({behavior:'smooth'});
  });
});
</script>


{% schema %}
{
  "name": "YouTube M20 Landing",
  "settings": []
}
{% endschema %}
